# ── Projectile builders ───────────────────────────────────────────────────────

## The archers' Attack_Projectile.png sheets are 96x96 — the pack's standard 3x3 grid of
## eight facings around an empty centre, the same shape ChainFactory reads for every other
## single-frame directional projectile. Reusing its helper keeps one cell mapping in the
## codebase instead of two.
static func _arrow_attack(id: String, sheet: String, damage: float, speed: float,
		range_px: float, cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.4
	config.hit_radius = 6.0
	config.sprite_frames = ChainFactory._grid8_frames(sheet, "undead_" + id)
	config.use_directional_anims = true
	config.fallback_color = Color(0.86, 0.84, 0.74, 1.0)
	config.pierce_count = 0

	var dmg := DealDamageEffect.new()
	dmg.damage_type = "Physical"
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile"]
	return _ability_from(id, config, range_px, cooldown, tags)


## The mages' Casted_Spell.png sheets are a single 12-frame row — an animated, directionless
## bolt. use_directional_anims stays false and `animation` is set so the manager plays the
## loop and rotates it toward travel, rather than freezing it on frame 0.
static func _spell_attack(id: String, sheet: String, frame_count: int, damage: float,
		damage_type: String, speed: float, range_px: float, cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.4
	config.hit_radius = 8.0
	config.sprite_frames = _row_frames(sheet, frame_count, 14.0)
	config.use_directional_anims = false
	config.animation = "default"
	config.fallback_color = Color(0.55, 0.35, 0.85, 1.0)
	config.pierce_count = 0

	var dmg := DealDamageEffect.new()
	dmg.damage_type = damage_type
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile", "Caster"]
	return _ability_from(id, config, range_px, cooldown, tags)


static func _row_frames(path: String, count: int, fps: float) -> SpriteFrames:
	var tex: Texture2D = load(path)
	var frames := SpriteFrames.new()
	## clear_all() KEEPS (re-creates) an empty "default" animation, so adding it again fails and
	## pushes an engine error every time the crypt casters are built — two per registry build.
	## Reuse the built-in one, same as weapon_factory.gd and chain_factory.gd already do.
	frames.clear_all()
	frames.set_animation_loop(&"default", true)
	frames.set_animation_speed(&"default", fps)
	if tex == null:
		return frames
	for i in count:
		var cell := AtlasTexture.new()
		cell.atlas = tex
		cell.region = Rect2(i * 32, 0, 32, 32)
		cell.filter_clip = true
		frames.add_frame(&"default", cell)
	return frames


## `tags` is Array[String], not Array: AbilityDefinition.tags is a TYPED array, and assigning an
## untyped one compiles cleanly and then throws at runtime ("Invalid assignment of property 'tags'
## with value of type 'Array'"). It only surfaced when EnemySpawnManager built the registry in a
## running game — every static check passed.
static func _ability_from(id: String, config: ProjectileConfig, range_px: float,
		cooldown: float, tags: Array[String]) -> AbilityDefinition:
	var spawn := SpawnProjectilesEffect.new()
	spawn.projectile = config
	spawn.spawn_pattern = "aimed_single"
	spawn.count = 1

	var aa := AbilityDefinition.new()
	aa.ability_id = id
	aa.ability_name = id
	aa.tags = tags
	aa.cooldown_base = cooldown
	aa.mode = "Auto"
	var targeting := TargetingRule.new()
	targeting.type = "nearest_enemy"
	targeting.max_range = range_px * 1.3
	aa.targeting = targeting
	aa.effects = [spawn]
	return aa
