# ── Projectile builders ───────────────────────────────────────────────────────

const PACK: String = "res://assets/minifantasy/Minifantasy_Monster_Creatures_v1.0/Minifantasy_Monster_Creatures_Assets/"


## All three thrown/cast projectiles in this pack ship as 96x96 sheets — the pack's standard
## 3x3 grid of eight facings around an empty centre, the same shape ChainFactory reads for
## every other single-frame directional projectile (and what the Catacombs archers use).
## Reusing its helper keeps one cell mapping in the codebase instead of two.
static func _thrown_attack(id: String, sheet: String, impact_sheet: String, damage: float,
		damage_type: String, speed: float, range_px: float, cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.4
	config.hit_radius = 7.0
	config.sprite_frames = ChainFactory._grid8_frames(sheet, "nightmare_" + id)
	config.use_directional_anims = true
	config.fallback_color = COL_PALE
	config.pierce_count = 0
	## This pack ships a matching impact sheet beside every projectile — wire it, or the
	## projectile vanishes with no punctuation.
	config.impact_sprite_frames = ChainFactory._oneshot_row_frames(impact_sheet, 16.0)
	config.impact_animation = "impact"

	var dmg := DealDamageEffect.new()
	dmg.damage_type = damage_type
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile"]
	return _ability_from(id, config, range_px, cooldown, tags)


## The mushroom has no projectile sheet — Spores_Attack.png is a BODY animation of it
## venting spores. So the cloud itself is procedural (fallback_color, no frames): a slow,
## short-range puff that reads as gas rather than a thrown object.
static func _spore_attack(id: String, damage: float, speed: float,
		range_px: float, cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.2
	config.hit_radius = 12.0          ## a cloud, not a dart
	config.use_directional_anims = false
	config.fallback_color = Color(0.62, 0.82, 0.48, 0.85)
	config.pierce_count = 2           ## drifts through a small crowd

	var dmg := DealDamageEffect.new()
	dmg.damage_type = "Poison"
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile"]
	return _ability_from(id, config, range_px, cooldown, tags)


## `tags` is Array[String], not Array: AbilityDefinition.tags is a TYPED array, and assigning
## an untyped one compiles cleanly and then throws at runtime. See the same note in
## crypt_enemy_data.gd — it only surfaced when EnemySpawnManager built the registry in a
## running game, with every static check passing.
static func _ability_from(id: String, config: ProjectileConfig, range_px: float,
		cooldown: float, tags: Array[String]) -> AbilityDefinition:
	var spawn := SpawnProjectilesEffect.new()
	spawn.projectile = config
	spawn.spawn_pattern = "aimed_single"
	spawn.count = 1

	var aa := AbilityDefinition.new()
	aa.ability_id = id
	aa.ability_name = id
	aa.tags = tags
	aa.cooldown_base = cooldown
	aa.mode = "Auto"
	var targeting := TargetingRule.new()
	targeting.type = "nearest_enemy"
	targeting.max_range = range_px * 1.3
	aa.targeting = targeting
	aa.effects = [spawn]
	return aa
