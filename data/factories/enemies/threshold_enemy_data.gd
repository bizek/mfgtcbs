static func create_th_caster() -> EnemyDefinition:
	var def := EnemyDefinition.new()
	def.enemy_id       = "th_caster"
	def.enemy_name     = "Dark Channeler"
	def.tags           = ["Ranged", "Caster", "Cultist"]
	def.base_stats     = {"max_hp": 40.0}
	def.combat_role    = "RANGED"
	def.move_speed     = 54.0
	def.contact_damage = 9.0
	def.base_armor     = 0.0
	def.xp_value       = 3.0
	def.health_drop_chance   = 0.07
	def.behavior_type        = "ranged"
	def.preferred_range      = 190.0
	## Procedural bolt: the Channeler ships no projectile sheet, because the pack's answer
	## to "what does it do at range" is Possess, which needs a transform hook the engine
	## does not have (see the header). Possess.png is still its cast animation, so the
	## gesture reads correctly and only the target-swap is absent.
	def.auto_attack = _procedural_bolt(
		"th_void_lash", 21.0, "Void", Color(0.62, 0.40, 0.86, 0.9),
		8.0, 0, 140.0, 190.0, 2.6)
	def.base_modulate  = COL_VOID
	return def


