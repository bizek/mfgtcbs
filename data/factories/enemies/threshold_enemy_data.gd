# ── Projectile builders ───────────────────────────────────────────────────────

const BROTHERHOOD: String = "res://assets/minifantasy/Minifantasy_Dark_Brotherhood_v1.0/Dark_Brotherhood/"


## Sprite-backed projectile from a 96x96 sheet — the pack's standard 3x3 grid of eight
## facings around an empty centre, the same shape ChainFactory reads for every other
## single-frame directional projectile. No impact sheet ships with it, so the bolt simply
## expires; ProjectileManager handles an unset impact_sprite_frames.
static func _sprite_bolt(id: String, sheet: String, damage: float, damage_type: String,
		speed: float, range_px: float, cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.4
	config.hit_radius = 7.0
	config.sprite_frames = ChainFactory._grid8_frames(sheet, "threshold_" + id)
	config.use_directional_anims = true
	config.fallback_color = COL_ASH
	config.pierce_count = 0

	var dmg := DealDamageEffect.new()
	dmg.damage_type = damage_type
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile"]
	return _ability_from(id, config, range_px, cooldown, tags)


## Frameless projectile for the two shooters whose packs ship only body animations.
## Same treatment the Nightmare Realm's spore cloud got, and for the same reason.
static func _procedural_bolt(id: String, damage: float, damage_type: String, color: Color,
		hit_radius: float, pierce: int, speed: float, range_px: float,
		cooldown: float) -> AbilityDefinition:
	var config := ProjectileConfig.new()
	config.motion_type = "directional"
	config.speed = speed
	config.max_range = range_px * 1.25
	config.hit_radius = hit_radius
	config.use_directional_anims = false
	config.fallback_color = color
	config.pierce_count = pierce

	var dmg := DealDamageEffect.new()
	dmg.damage_type = damage_type
	dmg.base_damage = damage
	config.on_hit_effects = [dmg]

	var tags: Array[String] = ["Ranged", "Projectile"]
	return _ability_from(id, config, range_px, cooldown, tags)


## `tags` is Array[String], not Array: AbilityDefinition.tags is a TYPED array, and assigning
## an untyped one compiles cleanly and then throws at runtime. Same note as
## nightmare_enemy_data.gd and crypt_enemy_data.gd — it only surfaces when EnemySpawnManager
## builds the registry in a running game, with every static check passing.
static func _ability_from(id: String, config: ProjectileConfig, range_px: float,
		cooldown: float, tags: Array[String]) -> AbilityDefinition:
	var spawn := SpawnProjectilesEffect.new()
	spawn.projectile = config
	spawn.spawn_pattern = "aimed_single"
	spawn.count = 1

	var aa := AbilityDefinition.new()
	aa.ability_id = id
	aa.ability_name = id
	aa.tags = tags
	aa.cooldown_base = cooldown
	aa.mode = "Auto"
	var targeting := TargetingRule.new()
	targeting.type = "nearest_enemy"
	targeting.max_range = range_px * 1.3
	aa.targeting = targeting
	aa.effects = [spawn]
	return aa
