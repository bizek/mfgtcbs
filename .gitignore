# Godot 4+ specific ignores
.godot/
/android/

# Export output (built binaries, never committed)
/build/

# Large asset bundles (source files, not tracked in git)
*.zip
assets/minifantasy/

# LDtk auto-backups (per-project backup folders)
**/backups/
*.ldtk-bak
*.ldtk.bak

# Claude Code worktrees (session-local sandboxes)
.claude/worktrees/

# Python tool caches
tools/__pycache__/
