# Godot 4+ specific ignores
.godot/
/android/

# Export output (built binaries, never committed)
/build/

# Large asset bundles (source files, not tracked in git)
*.zip
assets/minifantasy/

# LDtk auto-backups (per-project backup folders)
**/backups/
*.ldtk-bak
*.ldtk.bak

# Claude Code worktrees (session-local sandboxes)
.claude/worktrees/

# Python tool caches
tools/__pycache__/

# SFX forge WAV masters (regenerable from tools/sfx_forge; keep OGG audition sets only)
assets/audio/_incoming/**/*.wav

# GIF/screenshot captures from tools/frames_to_gif.py
out/
