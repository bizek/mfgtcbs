; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Extraction Survivors"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://jano7swspvg0"

[autoload]

GameManager="*res://scripts/managers/game_manager.gd"
UpgradeManager="*res://scripts/managers/upgrade_manager.gd"
EnemySpawnManager="*res://scripts/managers/enemy_spawn_manager.gd"
ExtractionManager="*res://scripts/managers/extraction_manager.gd"
ProgressionManager="*res://scripts/managers/progression_manager.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"
CodexManager="*res://scripts/systems/codex_manager.gd"
LootTables="*res://data/loot_tables.gd"
Settings="*res://scripts/managers/settings.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
InputGlyphs="*res://scripts/managers/input_glyphs.gd"
MCPScreenshot="*res://addons/godot_mcp/mcp_screenshot_service.gd"
MCPInputService="*res://addons/godot_mcp/mcp_input_service.gd"
MCPGameInspector="*res://addons/godot_mcp/mcp_game_inspector_service.gd"
AchievementManager="*res://scripts/managers/achievement_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

